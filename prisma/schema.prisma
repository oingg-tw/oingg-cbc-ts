generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "export"]
}

/// 10年期政府公債次級市場殖利率月資料，由 /api/ingest/gov-bond-yield-10y 觸發向央行統計資料庫 API
/// （FileName=EG43M01en，"29.Interest Rates -G.Capital Market Interest Rates By Period"）抓取，
/// 只取回應 data.structure.Table1 第 20 個欄位「Bond market-10-year gov't bond rates in secondary
/// market」（次級市場實際成交殖利率）。刻意不用第 4 欄「Government bonds-10-year」——那欄未標明是
/// 發行端得標利率還是次級市場殖利率，且跟公司債/銀行債那組信用利差資料混在同一張表，用來當 CAPM
/// 無風險利率不夠乾淨；次級市場殖利率才是跟 Beta（daily_stock_price）、市場風險溢酬同一種「市場
/// 觀察到的價格」，可以直接放進同一個 CAPM 公式。EG43M01en 整份表還有其餘 19 個公司債/銀行債/央行
/// 存單欄位，本表不存——跟這個用途無關。存的是月頻率百分比數字（例如 1.234 代表 1.234%），不是小數。
model MonthlyGovBondYield10y {
  year  Int // 西元年
  month Int // 1-12

  yieldRate Decimal @map("yield_rate") @db.Decimal(8, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([year, month])
  @@map("monthly_gov_bond_yield_10y")
  @@schema("public")
}

/// 財政部統計處《中華民國稅務行業標準分類（第9次修訂）》代碼字典，一列對應五層階層（大/中/小/細/
/// 子類）中的一個節點——不是只存葉節點，而是每一層都各自存一列，欄位裡自己那一層填自己的 code，
/// 上層祖先代碼另外存在 sectionCode/divisionCode/.../classCode 欄位，方便直接用某一層代碼過濾
/// （例如 WHERE section_code = 'K' 抓整個金融及保險業）。五種代碼格式（大類 1 碼英文字母、中類 2 碼
/// 數字、小類 3 碼、細類 4 碼、子類「4碼-2碼」）彼此定長不重疊，所以 code 本身就能直接當全域唯一鍵，
/// 不用另外疊代理鍵。這是靜態參考資料，不是像其他 domain 那樣定期向 CBC API 抓的時序資料，用一次性
/// seed script 匯入，之後只有官方改版才會變動。用途：解碼經濟部商工行政資料開放平台「公司行號營業
/// 項目代碼表」回傳的 Dgbas 欄位（4 碼細類代碼），展開成公司的完整大/中/小/細類產業階層。
model TaxIndustryClassification {
  code  String @id // 這一列自己所在那一層的代碼，例如大類"A"、中類"01"、小類"011"、細類"0111"、子類"0111-00"
  level String // section | division | group | class | subclass，對應大/中/小/細/子類

  sectionCode  String? @map("section_code") // 大類代碼（自己是大類時等於 code）
  divisionCode String? @map("division_code") // 中類代碼
  groupCode    String? @map("group_code") // 小類代碼
  classCode    String? @map("class_code") // 細類代碼
  subclassCode String? @map("subclass_code") // 子類代碼（自己是子類時等於 code）

  nameZh String  @map("name_zh") // 行業名稱（中文）
  nameEn String? @map("name_en") // Description（英文）

  definition String? @map("definition") @db.Text // 定義說明
  exclusions String? @map("exclusions") @db.Text // 「不包括」排除規則原文

  priorRevisionCode String? @map("prior_revision_code") // 對照第8次修訂分類編號，用於串接歷史資料

  companies CompanyIndustryClassification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([sectionCode])
  @@index([divisionCode])
  @@index([groupCode])
  @@index([classCode])
  @@map("tax_industry_classification")
  @@schema("public")
}

/// 公司主檔，由外部呼叫 POST /api/ingest/company-profile 帶入「證券代碼＋統編」登記時建立/更新。
/// taxId（統一編號）是 GCIS 商工登記資料本身的鍵，stockCode（證券代碼）是呼叫端自己配對好才傳進來
/// 的——這個服務不驗證兩者是否真的對應同一家公司，也不負責從證券代碼反查統編（那屬於以證券代碼為
/// 主鍵的服務，例如 oingg-mops-ts，的職責）。stockCode 設 @unique 是為了讓同一證券代碼不會意外登記
/// 到兩個不同統編下。companySetupDate 故意存 GCIS 原始格式（民國年月日無分隔，例如"0760221"）不轉型
/// 別，避免猜錯民國/西元換算規則。
model CompanyProfile {
  taxId     String @id @map("tax_id") // 統一編號（GCIS Business_Accounting_NO），8碼數字
  stockCode String @unique @map("stock_code") // 證券代碼，登記時由呼叫端提供

  companyName       String @map("company_name")
  companyStatus     String @map("company_status")
  companyStatusDesc String @map("company_status_desc")
  companySetupDate  String @map("company_setup_date")

  businessItems           CompanyBusinessItem[]
  industryClassifications CompanyIndustryClassification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("company_profiles")
  @@schema("public")
}

/// CompanyProfile 底下的營業項目快照，來源是登記當下 GCIS 回應的 Cmp_Business 陣列。GCIS 每次回應
/// 都是「當下完整清單」而非增量，所以每次重新登記時這張表整批刪除重建（見 companyProfile/service.ts），
/// 不逐筆比對更新。itemCode 對應 Business_Item：GCIS 這個欄位有時是空白（只有空格），代表這一列其實
/// 是「所營事業資料」的自由文字說明、不是代碼化項目，這種情況存 null。這裡的代碼格式（例如"CC01080"）
/// 跟 TaxIndustryClassification 的代碼格式不同，是經濟部商業登記自己的行業代碼，兩者尚未建立對照，
/// 不能直接拿 TaxIndustryClassification 解碼。
///
/// position（不是 seqNo）才是唯一鍵：實測發現 GCIS 的回應裡，不少公司的營業項目會整列重複兩次
/// （seqNo/itemCode/itemDesc 三個欄位完全一樣，不是序號剛好撞在一起，是同一筆資料真的出現兩次，
/// 例如雲豹能源科技 42852207 的 56 筆原始資料其實只有 28 個不重複項目）——這是 GCIS 自己回應內容
/// 的問題。service.ts 寫入前會用 seqNo+itemCode+itemDesc 三欄組合去重，這裡存的都是去重後的資料，
/// 不會有完全重複的列。position 是去重後在陣列裡的 0-based 索引，我們自己產生、保證同一次寫入不會
/// 重複，用它保留原始排序、也用它當唯一鍵；seqNo 純粹存 GCIS 原始值供參考，不拿來保證唯一。
model CompanyBusinessItem {
  id      Int            @id @default(autoincrement())
  taxId   String         @map("tax_id")
  company CompanyProfile @relation(fields: [taxId], references: [taxId], onDelete: Cascade)

  position Int     @map("position") // 該筆在 GCIS 回應 Cmp_Business 陣列裡的 0-based 索引，用來排序也用來保證唯一
  seqNo    String  @map("seq_no") // Business_Seq_NO，GCIS 原始值，僅供參考（不保證唯一，見上方註解）
  itemCode String? @map("item_code") // Business_Item，空白視為 null
  itemDesc String  @map("item_desc") // Business_Item_Desc

  @@unique([taxId, position])
  @@index([itemCode])
  @@map("company_business_items")
  @@schema("public")
}

/// 記錄 registerCompanyProfile（POST /api/ingest/company-profile）失敗的統編，一個統編一列（用
/// taxId 當主鍵 upsert，不是每次失敗都新增一列）——目的是回答「目前還有哪些統編沒成功登記」，不是
/// 完整的歷史稽核軌跡，所以重複失敗只累加 attempts、更新 error/updatedAt，不留舊的錯誤訊息。之後
/// 只要該統編成功登記（不論是新登記還是 force 覆寫），這一列就會被刪除——這張表裡有資料，就代表
/// 「這個統編從沒成功過」。
model CompanyProfileIngestionFailure {
  taxId     String @id @map("tax_id") // 統一編號
  stockCode String @map("stock_code") // 最後一次嘗試時帶的證券代碼

  error    String @db.Text // 最後一次失敗的錯誤訊息
  attempts Int    @default(1) // 累積失敗次數

  createdAt DateTime @default(now()) @map("created_at") // 第一次失敗的時間
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") // 最後一次失敗的時間

  @@map("company_profile_ingestion_failures")
  @@schema("public")
}

/// analysis-ts「數據中台」export 契約層的一部分（2026-08-31 應 analysis-ts 要求新增）。這不是內部
/// 使用的表——export schema 只授權 SELECT 給一個專用的唯讀 role（etl_reader），analysis-ts 靠這張
/// 表判斷某個 dataset 的某批資料是否「可信、已完成」：他們只認 status = 'success' 的紀錄，raw 表
/// 裡就算已經有資料，沒有對應的 success 紀錄也當作不存在。
///
/// 顆粒度是「一次 ingest 呼叫」，不是逐月——CBC 的 EG43M01en 端點本身一次就回傳 1987-M5 至今整段
/// 月資料，沒有自然的逐月分批單位（見 MonthlyGovBondYield10y 的註解）。dataDate 記這批資料實際涵蓋
/// 到的最新月份（不是「今天」，是資料本身的最新業務日期），讓 analysis-ts 知道資料新鮮到哪個月。
model IngestionRun {
  runId       BigInt   @id @default(autoincrement()) @map("run_id")
  dataset     String // 對應 export schema 裡的哪個 view，例如 "monthly_gov_bond_yield_10y"
  dataDate    DateTime @map("data_date") @db.Date // 這批資料涵蓋到的最新業務日期（不是 ingest 執行的時間）
  completedAt DateTime @default(now()) @map("completed_at")
  rowCount    Int      @map("row_count")
  status      String // success | partial | failed

  @@index([dataset, status])
  @@map("ingestion_runs")
  @@schema("export")
}

/// 每家公司(用 CompanyProfile.taxId)對應「最多四個」官方行業分類代碼，來源是財政部財政資訊中心
/// 《全國營業(稅籍)登記資料集》(data.gov.tw/dataset/9400，每日更新、約171萬列全國登記營業人，沒有
/// 查詢式 API，只能整份下載再過濾)——不是拿 CompanyBusinessItem(GCIS 營業項目)反推，那是完全不同的
/// 代碼系統且一家公司常十幾筆、雜訊很大(2026-08-31 已用亞洲水泥 1102 實測驗證過對不起來)。
///
/// 這份稅籍登記資料裡，同一個統編會有多「列」(總公司+各分公司/廠各自的稅籍登記)，用「統一編號=自己、
/// 總機構統一編號=空白」鎖定總公司本身那一列；但同一列裡本身又有最多四組行業代號欄位(主要行業代號+
/// 次要1/2/3，實測驗證過統編22099131台積電同一列就有三組：主要261199「其他積體電路製造」、次要1
/// 261111「矽晶圓製造」、次要2 282011「一次電池製造」)，早期版本只取主要那組，2026-09-02 改成四組
/// 都存，用 rank 區分(0=主要，1/2/3=次要，對應行業代號/行業代號1/2/3 的原始欄位順序)。原始格式是
/// 6碼數字(例如"233100")，轉換規則是前4碼+"-"+後2碼(例如"2331-00")，剛好對應
/// TaxIndustryClassification 的 subclass 代碼格式——已用亞洲水泥實測驗證：財政部登記的 "233100"
/// 對到 "2331-00"「水泥製造」，跟實際主業完全吻合，不是巧合。
///
/// 因為來源檔案是全國性、不分上市櫃，這裡刻意只收 CompanyProfile 裡已經追蹤的公司(見
/// companyIndustryClassification/service.ts)，不落地全部171萬筆。每次重新 ingest 整批刪除重建(理由
/// 跟 CompanyBusinessItem 一樣：來源是「當下完整清單」，不逐筆比對更新)。
model CompanyIndustryClassification {
  id      Int            @id @default(autoincrement())
  taxId   String         @map("tax_id")
  company CompanyProfile @relation(fields: [taxId], references: [taxId], onDelete: Cascade)

  rank               Int                       @map("rank") // 0=主要(行業代號)，1/2/3=次要(行業代號1/2/3)，同一統編不會重複
  industryCode       String                    @map("industry_code") // 轉換成 subclass 格式(例如"2331-00")，對應 TaxIndustryClassification.code
  classification     TaxIndustryClassification @relation(fields: [industryCode], references: [code])
  sourceIndustryName String                    @map("source_industry_name") // 財政部登記當下的行業名稱原文，供核對用(理論上該跟 classification.nameZh 一致)
  registeredAddress  String?                   @map("registered_address") // 總公司登記地址，一併存下來供人工核對(同一統編的每一列重複存，換取查詢時不用額外 join)

  fetchedAt DateTime @default(now()) @map("fetched_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([taxId, rank])
  @@index([industryCode])
  @@map("company_industry_classifications")
  @@schema("public")
}
