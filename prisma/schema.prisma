generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// 10年期政府公債次級市場殖利率月資料，由 /api/ingest/gov-bond-yield-10y 觸發向央行統計資料庫 API
/// （FileName=EG43M01en，"29.Interest Rates -G.Capital Market Interest Rates By Period"）抓取，
/// 只取回應 data.structure.Table1 第 20 個欄位「Bond market-10-year gov't bond rates in secondary
/// market」（次級市場實際成交殖利率）。刻意不用第 4 欄「Government bonds-10-year」——那欄未標明是
/// 發行端得標利率還是次級市場殖利率，且跟公司債/銀行債那組信用利差資料混在同一張表，用來當 CAPM
/// 無風險利率不夠乾淨；次級市場殖利率才是跟 Beta（daily_stock_price）、市場風險溢酬同一種「市場
/// 觀察到的價格」，可以直接放進同一個 CAPM 公式。EG43M01en 整份表還有其餘 19 個公司債/銀行債/央行
/// 存單欄位，本表不存——跟這個用途無關。存的是月頻率百分比數字（例如 1.234 代表 1.234%），不是小數。
model MonthlyGovBondYield10y {
  year  Int // 西元年
  month Int // 1-12

  yieldRate Decimal @map("yield_rate") @db.Decimal(8, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([year, month])
  @@map("monthly_gov_bond_yield_10y")
}

/// 財政部統計處《中華民國稅務行業標準分類（第9次修訂）》代碼字典，一列對應五層階層（大/中/小/細/
/// 子類）中的一個節點——不是只存葉節點，而是每一層都各自存一列，欄位裡自己那一層填自己的 code，
/// 上層祖先代碼另外存在 sectionCode/divisionCode/.../classCode 欄位，方便直接用某一層代碼過濾
/// （例如 WHERE section_code = 'K' 抓整個金融及保險業）。五種代碼格式（大類 1 碼英文字母、中類 2 碼
/// 數字、小類 3 碼、細類 4 碼、子類「4碼-2碼」）彼此定長不重疊，所以 code 本身就能直接當全域唯一鍵，
/// 不用另外疊代理鍵。這是靜態參考資料，不是像其他 domain 那樣定期向 CBC API 抓的時序資料，用一次性
/// seed script 匯入，之後只有官方改版才會變動。用途：解碼經濟部商工行政資料開放平台「公司行號營業
/// 項目代碼表」回傳的 Dgbas 欄位（4 碼細類代碼），展開成公司的完整大/中/小/細類產業階層。
model TaxIndustryClassification {
  code  String @id // 這一列自己所在那一層的代碼，例如大類"A"、中類"01"、小類"011"、細類"0111"、子類"0111-00"
  level String // section | division | group | class | subclass，對應大/中/小/細/子類

  sectionCode  String? @map("section_code") // 大類代碼（自己是大類時等於 code）
  divisionCode String? @map("division_code") // 中類代碼
  groupCode    String? @map("group_code") // 小類代碼
  classCode    String? @map("class_code") // 細類代碼
  subclassCode String? @map("subclass_code") // 子類代碼（自己是子類時等於 code）

  nameZh String  @map("name_zh") // 行業名稱（中文）
  nameEn String? @map("name_en") // Description（英文）

  definition String? @map("definition") @db.Text // 定義說明
  exclusions String? @map("exclusions") @db.Text // 「不包括」排除規則原文

  priorRevisionCode String? @map("prior_revision_code") // 對照第8次修訂分類編號，用於串接歷史資料

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([sectionCode])
  @@index([divisionCode])
  @@index([groupCode])
  @@index([classCode])
  @@map("tax_industry_classification")
}

/// 公司主檔，由外部呼叫 POST /api/ingest/company-profile 帶入「證券代碼＋統編」登記時建立/更新。
/// taxId（統一編號）是 GCIS 商工登記資料本身的鍵，stockCode（證券代碼）是呼叫端自己配對好才傳進來
/// 的——這個服務不驗證兩者是否真的對應同一家公司，也不負責從證券代碼反查統編（那屬於以證券代碼為
/// 主鍵的服務，例如 oingg-mops-ts，的職責）。stockCode 設 @unique 是為了讓同一證券代碼不會意外登記
/// 到兩個不同統編下。companySetupDate 故意存 GCIS 原始格式（民國年月日無分隔，例如"0760221"）不轉型
/// 別，避免猜錯民國/西元換算規則。
model CompanyProfile {
  taxId     String @id @map("tax_id") // 統一編號（GCIS Business_Accounting_NO），8碼數字
  stockCode String @unique @map("stock_code") // 證券代碼，登記時由呼叫端提供

  companyName       String @map("company_name")
  companyStatus     String @map("company_status")
  companyStatusDesc String @map("company_status_desc")
  companySetupDate  String @map("company_setup_date")

  businessItems CompanyBusinessItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("company_profiles")
}

/// CompanyProfile 底下的營業項目快照，來源是登記當下 GCIS 回應的 Cmp_Business 陣列。GCIS 每次回應
/// 都是「當下完整清單」而非增量，所以每次重新登記時這張表整批刪除重建（見 companyProfile/service.ts），
/// 不逐筆比對更新。itemCode 對應 Business_Item：GCIS 這個欄位有時是空白（只有空格），代表這一列其實
/// 是「所營事業資料」的自由文字說明、不是代碼化項目，這種情況存 null。這裡的代碼格式（例如"CC01080"）
/// 跟 TaxIndustryClassification 的代碼格式不同，是經濟部商業登記自己的行業代碼，兩者尚未建立對照，
/// 不能直接拿 TaxIndustryClassification 解碼。
model CompanyBusinessItem {
  id      Int            @id @default(autoincrement())
  taxId   String         @map("tax_id")
  company CompanyProfile @relation(fields: [taxId], references: [taxId], onDelete: Cascade)

  seqNo    String  @map("seq_no") // Business_Seq_NO，GCIS 回應裡的原始排序
  itemCode String? @map("item_code") // Business_Item，空白視為 null
  itemDesc String  @map("item_desc") // Business_Item_Desc

  @@unique([taxId, seqNo])
  @@index([itemCode])
  @@map("company_business_items")
}
